# API données de vols
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
AVIATIONSTACK_API_KEY=          # optionnel, fallback payant

# API météo
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
OPENWEATHER_API_KEY=            # météo temps réel pour l'inférence (src/collector/openweather_client.py)

# Base de données
DATABASE_URL=sqlite:///./data/processed/dst_airlines.db
# Exemple pour Postgres (docker-compose) :
# DATABASE_URL=postgresql://dst:dst@localhost:5432/dst_airlines

# Entrepôt historique (schéma en étoile, src/etl/warehouse.py) : PostgreSQL obligatoire.
# Base docker-compose locale, ou l'URL Neon (…?sslmode=require).
WAREHOUSE_DATABASE_URL=postgresql://dst:dst@localhost:5432/dst_airlines

# API applicative
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000     # API appelée par src/ml/score.py

# MLflow (optionnel) — backend fichier "./mlruns" déprécié côté MLflow,
# on utilise un backend SQLite local par défaut.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Collecteur
PILOT_AIRPORTS=ATL,JFK
